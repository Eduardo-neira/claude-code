# Copia a .env y completa. NO subas este archivo con valores reales al repo.

# --- SMTP / Gmail ---
# Para Gmail: activa la verificación en dos pasos y genera una
# "contraseña de aplicación" (App Password) de 16 caracteres.
SMTP_USERNAME=tu_correo@gportatil.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Google Sheets (opcional, sólo si usas ese backend) ---
SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# Alternativa a credentials_file: ruta al JSON de la cuenta de servicio.
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
