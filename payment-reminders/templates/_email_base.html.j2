{#
  Plantilla HTML base para todos los recordatorios.
  Cada etapa la extiende y define:
    - accent      (color de acento, variable)
    - block heading
    - block intro
    - block extra  (opcional)
#}
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0; padding:0; background:#f4f5f7;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7; padding:24px 0;">
    <tr><td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0"
             style="max-width:600px; width:100%; background:#ffffff; border-radius:8px; overflow:hidden; font-family:Arial,Helvetica,sans-serif;">
        <tr>
          <td style="background:{{ accent | default('#1f6feb') }}; padding:20px 28px;">
            <span style="color:#ffffff; font-size:18px; font-weight:bold;">{{ company.name or 'Cuentas por cobrar' }}</span>
          </td>
        </tr>
        <tr>
          <td style="padding:28px;">
            <h1 style="margin:0 0 16px; font-size:20px; color:#111;">{% block heading %}Recordatorio de pago{% endblock %}</h1>
            <p style="margin:0 0 16px; font-size:14px; color:#333; line-height:1.55;">
              Estimado(a) <strong>{{ invoice.client_name }}</strong>:
            </p>
            <div style="font-size:14px; color:#333; line-height:1.55;">
              {% block intro %}{% endblock %}
            </div>

            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                   style="margin:20px 0; border:1px solid #e3e6ea; border-radius:6px;">
              <tr><td style="padding:10px 14px; font-size:13px; color:#666; border-bottom:1px solid #eef0f2;">Factura</td>
                  <td style="padding:10px 14px; font-size:13px; color:#111; text-align:right; border-bottom:1px solid #eef0f2;"><strong>{{ invoice.invoice_id }}</strong></td></tr>
              <tr><td style="padding:10px 14px; font-size:13px; color:#666; border-bottom:1px solid #eef0f2;">Monto</td>
                  <td style="padding:10px 14px; font-size:15px; color:#111; text-align:right; border-bottom:1px solid #eef0f2;"><strong>{{ amount_display }}</strong></td></tr>
              <tr><td style="padding:10px 14px; font-size:13px; color:#666;">Vencimiento</td>
                  <td style="padding:10px 14px; font-size:13px; color:#111; text-align:right;">{{ due_date_display }}</td></tr>
            </table>

            {% if invoice.payment_link %}
            <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
              <tr><td style="border-radius:6px; background:{{ accent | default('#1f6feb') }};">
                <a href="{{ invoice.payment_link }}"
                   style="display:inline-block; padding:12px 24px; font-size:14px; color:#ffffff; text-decoration:none; font-weight:bold;">
                   Pagar ahora
                </a>
              </td></tr>
            </table>
            {% endif %}

            {% if company.payment_instructions %}
            <p style="margin:0 0 16px; font-size:13px; color:#555; line-height:1.55;">{{ company.payment_instructions }}</p>
            {% endif %}

            {% block extra %}{% endblock %}

            <p style="margin:20px 0 0; font-size:13px; color:#555; line-height:1.55;">
              Si ya realizó el pago, por favor ignore este mensaje o compártanos su comprobante.
            </p>
          </td>
        </tr>
        <tr>
          <td style="padding:18px 28px; background:#fafbfc; border-top:1px solid #eef0f2; font-size:12px; color:#888;">
            {{ company.signature or company.name or 'Equipo de Cobranza' }}<br>
            {% if company.phone %}Tel: {{ company.phone }}<br>{% endif %}
            {% if company.collections_email %}Cobranza: {{ company.collections_email }}{% endif %}
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
